{
	"name": "Ls_Metadata_Store",
	"properties": {
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "metdata.database.windows.net",
			"database": "metadata",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "metadata",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "KeyvaultCredentials",
					"type": "LinkedServiceReference"
				},
				"secretName": "metadata-password"
			}
		}
	}
}