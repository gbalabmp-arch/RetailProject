					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select distinct a.*,b.status from ctrl.ctrl_source_to_bronze a \nleft join (select * from ctrl.audit_source_to_bronze where start_time>(select max(start_time) from ctrl.audit_source_to_bronze where status='completed')\n) b on (a.config_id=b.config_id)",
