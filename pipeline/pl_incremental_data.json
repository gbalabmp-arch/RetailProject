													"scripts": [
														{
															"type": "NonQuery",
															"text": {
																"value": "@concat('update ctrl.audit_source_to_bronze set status=','''in progress''',' where config_id=',item().config_id)",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
