{
	"name": "pl_incremental_data",
	"properties": {
		"activities": [
			{
				"name": "metadata_infor",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select a.*,b.status from ctrl.ctrl_source_to_bronze a \nleft join (select * from ctrl.audit_source_to_bronze where start_time>(select max(start_time) from ctrl.audit_source_to_bronze where status='completed')\n) b on (a.config_id=b.config_id)\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Metadata_Tables",
						"type": "DatasetReference",
						"parameters": {
							"shema_name": "ctrl"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter_Records_Env_Fail",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "metadata_infor",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('metadata_infor').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(coalesce(pipeline().parameters.Environment, 'dev'), 'dev'), or(contains(createArray('Failed', 'in progress'), item().status), empty(item().status)))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
