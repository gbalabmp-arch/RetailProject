{
	"name": "pl_copy_xml_files",
	"properties": {
		"activities": [
			{
				"name": "XML_File_List",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Assign_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_METADATA_BINARY",
						"type": "DatasetReference",
						"parameters": {
							"source_container": {
								"value": "@pipeline().parameters.source_container",
								"type": "Expression"
							},
							"source_path": {
								"value": "@pipeline().parameters.source_path",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('XML_File_List').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "copy_from_xml_blob",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "FlattenHierarchy"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_METADATA_BINARY_XML_COPY",
									"type": "DatasetReference",
									"parameters": {
										"source_container": {
											"value": "@pipeline().parameters.source_container",
											"type": "Expression"
										},
										"source_path": {
											"value": "@pipeline().parameters.source_path",
											"type": "Expression"
										},
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_METADATA_TARGET_EACH_FILE",
									"type": "DatasetReference",
									"parameters": {
										"landing_container": {
											"value": "@pipeline().parameters.landing_container",
											"type": "Expression"
										},
										"landing_path": {
											"value": "@pipeline().parameters.landing_path",
											"type": "Expression"
										},
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Filter_ejdataent",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": []
			},
			{
				"name": "Filter_ejdataent",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "XML_File_List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('XML_File_List').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@startswith(item().name, 'ejdataent')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Assign_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "file_date",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"source_container": {
				"type": "string"
			},
			"source_path": {
				"type": "string"
			},
			"landing_container": {
				"type": "string"
			},
			"landing_path": {
				"type": "string"
			}
		},
		"variables": {
			"file_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}